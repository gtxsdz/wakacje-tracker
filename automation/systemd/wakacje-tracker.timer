# Timer systemd uruchamiający wakacje-tracker.service co godzinę w oknie 08:30–22:30.
# Persistent=true => jeśli maszyna była wyłączona o zaplanowanej porze,
# zadanie uruchomi się zaraz po starcie.

[Unit]
Description=Pobranie cen wakacje.pl (co godzinę: 08:30–22:30)

[Timer]
OnCalendar=*-*-* 08..22:30:00
Persistent=true

[Install]
WantedBy=timers.target
