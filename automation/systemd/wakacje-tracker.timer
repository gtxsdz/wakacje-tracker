# Timer systemd uruchamiający wakacje-tracker.service dwa razy dziennie: 10:00 i 18:00.
# Persistent=true => jeśli maszyna była wyłączona o zaplanowanej porze,
# zadanie uruchomi się zaraz po starcie.

[Unit]
Description=Pobranie cen wakacje.pl (2x dziennie: 10:00 i 18:00)

[Timer]
OnCalendar=*-*-* 10,18:00:00
Persistent=true

[Install]
WantedBy=timers.target
