# Timer systemd uruchamiający wakacje-tracker.service 3x dziennie: 08:30, 12:30, 18:30.
# Persistent=true => jeśli maszyna była wyłączona o zaplanowanej porze,
# zadanie uruchomi się zaraz po starcie.

[Unit]
Description=Pobranie cen wakacje.pl (3x dziennie: 08:30, 12:30, 18:30)

[Timer]
OnCalendar=*-*-* 08,12,18:30:00
Persistent=true

[Install]
WantedBy=timers.target
